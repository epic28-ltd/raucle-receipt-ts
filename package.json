{
  "name": "@raucle/receipt",
  "version": "0.1.0",
  "description": "TypeScript reference implementation of the Raucle Provenance Receipt v1 spec — cryptographic chain-of-custody for AI workflows",
  "license": "MIT",
  "author": "Raucle",
  "homepage": "https://raucle.com/spec/provenance/v1",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/craigamcw/raucle-receipt-ts.git"
  },
  "bugs": "https://github.com/craigamcw/raucle-receipt-ts/issues",
  "keywords": [
    "llm",
    "ai-security",
    "provenance",
    "jws",
    "ed25519",
    "raucle",
    "audit",
    "compliance",
    "agentic"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "build": "tsc",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm test"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.1.9",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  }
}
